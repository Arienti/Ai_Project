<UserControl x:Class="Ai_Project.Content.Controls.AuthorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Ai_Project.Content.Controls"
             mc:Ignorable="d" 
             Height="41" d:DesignWidth="275"  Margin="0 0 0 17px" Cursor="Hand">

    <Border x:Name="border" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="6" Background="{StaticResource TopicFocusBg}" ToolTip="{Binding ElementName=AuthorTextBlock, Path=Text}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="6" Opacity="0.2" Color="Black"/>
        </Border.Effect>
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                    To="#FFd0D2FB"
                                    Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>

                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation
                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                    To="#FFe8E9FD"
                                    Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid Margin="5 0 5 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="27"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border x:Name="LogoBorder"  Height="27"  CornerRadius="50" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <TextBlock x:Name="FirstLetterTextBlock" HorizontalAlignment="Center" 
                            VerticalAlignment="Center" 
                            Foreground="White" 
                            FontWeight="Bold" 
                            FontSize="21"/>
            </Border>
            <TextBlock x:Name="AuthorTextBlock"
                       Grid.Column="1"
                       Foreground="#FF181818"
                       Margin="10 0"
                       FontSize="21"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
