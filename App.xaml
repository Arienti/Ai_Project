<Application x:Class="Ai_Project.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ai_Project"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PrimaryBg" Color="#FF505275"/>
        <SolidColorBrush x:Key="PrimaryBgHover">#FF3b3f5c</SolidColorBrush>
        
        <SolidColorBrush x:Key="SecondaryBg" Color="#FFF07371"/>
        <SolidColorBrush x:Key="ThirdBg" Color="#FF7178F0"/>
        <SolidColorBrush x:Key="FourthyBg" Color="#FFF0D671"/>
        <SolidColorBrush x:Key="FifthBg" Color="#FF71F09A"/>

        <SolidColorBrush x:Key="PrimaryFg" Color="#FFe8e9fd"/>
    </Application.Resources>
</Application>
