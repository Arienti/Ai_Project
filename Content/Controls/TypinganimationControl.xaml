<UserControl x:Class="Ai_Project.Content.Controls.TypinganimationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Ai_Project.Content.Controls"
             mc:Ignorable="d" 
             Height="32" Width="77" Margin="0 5 0 0" HorizontalAlignment="Left">
    <Grid>
        <!-- Rounded bubble background -->
        <Border x:Name="Bubble"
                Background="{StaticResource TextChatBGColor}"
                CornerRadius="18"
                Padding="10,6"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- 3 animated dots -->
                <Ellipse x:Name="Dot1" Width="8" Height="8" Fill="{StaticResource ChatForeground}" Margin="4,0">
                    <Ellipse.RenderTransform>
                        <TranslateTransform Y="0"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Ellipse x:Name="Dot2" Width="8" Height="8" Fill="{StaticResource ChatForeground}" Margin="4,0">
                    <Ellipse.RenderTransform>
                        <TranslateTransform Y="0"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Ellipse x:Name="Dot3" Width="8" Height="8" Fill="{StaticResource ChatForeground}" Margin="4,0">
                    <Ellipse.RenderTransform>
                        <TranslateTransform Y="0"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
