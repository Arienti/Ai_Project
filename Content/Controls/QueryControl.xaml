<UserControl x:Class="Ai_Project.Content.Controls.QueryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:Ai_Project.Content.Controls"
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
             mc:Ignorable="d" 
             MaxWidth="525" Margin="0 11 5 0" HorizontalAlignment="Right">

    <Grid x:Name="grid" 
          Background="Transparent"
          HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="21px"/>
        </Grid.RowDefinitions>

        <Border x:Name="border"
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch"
                CornerRadius="18" 
                Background="{StaticResource TextChatBGColor}">

            <emoji:RichTextBox x:Name="QueryTextBox"
                               Padding="0"
                               Margin="5 5 5 7"
                               Background="Transparent"
                               BorderThickness="0"
                               IsReadOnly="True"
                               FontSize="16px"
                               HorizontalAlignment="Stretch" 
                               VerticalAlignment="Stretch"
                               AcceptsReturn="True"
                               Foreground="{StaticResource ChatForeground}"
                               Text="{Binding Content}"/>
        </Border>
        <Border Grid.Row="1" HorizontalAlignment="Stretch" Margin="0 3 7 0" CornerRadius="5" Background="Transparent">
            <Grid Grid.Row="1"
                  x:Name="DateCopyGrid"
                  Width="Auto"
                  VerticalAlignment="Stretch"
                  HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SenderTextBlock"
                           Text="{Binding Sender}"
                           Grid.Column="2"
                           FontSize="14px"
                           Margin="0 0 3 0"
                           TextWrapping="NoWrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom"
                           FontWeight="Bold"
                           Foreground="{StaticResource ChatForeground}"/>


                <TextBlock x:Name="QueryTextBlock"
                           Text="{Binding CreatedAt, StringFormat='MM-dd-yyyy HH:mm'}"
                           Grid.Column="3"
                           FontSize="14px"
                           Margin="0 0 3 0"
                           TextWrapping="NoWrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom"
                           FontWeight="Bold"
                           Foreground="{StaticResource ChatForeground}"/>

                <Icon:PackIconMaterial x:Name="CopyToClipboardIcon" 
                                       Grid.Column="0"
                                       Kind="ContentCopy"
                                       Width="18"
                                       Height="18"
                                       Cursor="Hand"
                                       Background="Transparent"
                                       Padding="2px"
                                       Foreground="{StaticResource ChatForeground}"
                                       Margin="1 0 0 0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       ToolTip="Copy message"
                                       PreviewMouseDown="CopyToClipboardIcon_PreviewMouseDown"
                                       PreviewMouseUp="CopyToClipboardIcon_PreviewMouseUp"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
