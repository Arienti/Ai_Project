<UserControl x:Class="Ai_Project.Content.Controls.ResponseControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
             xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:Ai_Project.Content.Controls"
             mc:Ignorable="d" 
             MinWidth="77" MaxWidth="850" Margin="5px 11 0 0" HorizontalAlignment="Left">

    <Grid HorizontalAlignment="Left" 
          Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="21px"/>
        </Grid.RowDefinitions>

        <Border Margin="1" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch" 
                CornerRadius="14" 
                Background="{StaticResource TextChatBGColor}">
            <StackPanel x:Name="ContentPanel" Orientation="Vertical" Margin="7"/>


        </Border>
        <Border x:Name="DateCopyGrid" Grid.Row="1" HorizontalAlignment="Stretch" Margin="2 3 0 0" CornerRadius="5" Background="Transparent">
            <Grid Grid.Row="1"
              HorizontalAlignment="Stretch"
              Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SenderTextBlock"
                       Text="{Binding Sender}"
                       FontSize="14px"
                       Margin="3 0 0 0"
                       TextWrapping="NoWrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       FontWeight="Bold"
                       Foreground="{StaticResource ChatForeground}"/>


                <TextBlock x:Name="QueryTextBlock"
                       Text="{Binding CreatedAt, StringFormat='MM-dd-yyyy HH:MM'}"
                       Grid.Column="1"
                       FontSize="14px"
                       Margin="11 0 0 0"
                       TextWrapping="NoWrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       FontWeight="Bold"
                       Foreground="{StaticResource ChatForeground}"/>

                <Icon:PackIconMaterial x:Name="CopyToClipboardIcon" 
                                   Grid.Column="2"
                                   Kind="ContentCopy"
                                   Width="18"
                                   Height="18"
                                   Cursor="Hand"
                                   Background="Transparent"
                                   Padding="2px"
                                   Foreground="{StaticResource ChatForeground}"
                                   Margin="10 0 3 0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   ToolTip="Copy message"
                                   PreviewMouseDown="CopyToClipboardIcon_PreviewMouseDown"
                                   PreviewMouseUp="CopyToClipboardIcon_PreviewMouseUp"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>