<Page x:Class="Ai_Project.Content.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Ai_Project.Content"
      xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
      xmlns:ctrls="clr-namespace:Ai_Project.Content.Controls"
      xmlns:dto="clr-namespace:Ai_Project.DTO"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ChatPage">

    <Grid Grid.Column="1" Margin="5 27 5 0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="124px"/>
        </Grid.RowDefinitions>
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border x:Name="WelcomeAiBorder" CornerRadius="43" Height="113" Width="525" VerticalAlignment="Top" Margin="0 43 0 0" Background="{StaticResource PrimaryBg}">
                    <StackPanel HorizontalAlignment="Stretch" 
                                VerticalAlignment="Stretch" 
                                Orientation="Vertical"
                                Margin="0 10 0 0">
                        <TextBlock Text="Hello"
                                   FontSize="43"
                                   Foreground="{StaticResource PrimaryFg}"
                                   HorizontalAlignment="Center"                                   />
                        <TextBlock Text="I am here to assist you. Please feel free to ask any questions."
                                   FontSize="16"
                                   Foreground="{StaticResource PrimaryFg}"
                                   HorizontalAlignment="Center"
                                   Margin="0 10 0 0"/>
                    </StackPanel>
                </Border>
                <ScrollViewer x:Name="PromptMessagesScroll" 
                              MaxWidth="854px"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PromptMessagesPanel" Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <TextBox x:Name="PromptResponse"
                                     Margin="8px"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     IsReadOnly="True"
                                     FontSize="14px"
                                     HorizontalAlignment="Stretch" 
                                     VerticalAlignment="Stretch"
                                     AcceptsReturn="False"
                                     TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
        <Border  Grid.RowSpan="2" 
                 x:Name="UserPrompt"
                 CornerRadius="28" 
                 MinWidth="525px" 
                 MaxWidth="850" 
                 Margin="15"
                 MinHeight="90px" 
                 MaxHeight="340px"
                 BorderThickness="1" 
                 BorderBrush="DarkGray"
                 Background="White"
            HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="15px">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="27px"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="43px"/>
                </Grid.ColumnDefinitions>
                <Icon:PackIconMaterial Kind="Plus" Cursor="Hand" 
                                   Foreground="Gray" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   Background="Transparent"/>
                <TextBlock Grid.Column="1" 
                       Text="Ask anything . . ." 
                       FontSize="16" 
                       Foreground="Gray"
                       IsHitTestVisible="False"
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Center"
                       Visibility="Collapsed">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <!-- Show TextBlock only when the TextBox is empty -->
                                <DataTrigger Binding="{Binding Text.Length, ElementName=QueryTextBox}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <emoji:RichTextBox x:Name="QueryTextBox"
                         Grid.Column="1"
                         FontSize="16"
                         FontFamily="Segoe UI, Segoe UI Emoji, Segoe UI Symbol"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         BorderThickness="0"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Center"
                         Margin="0 0 13 0"
                         PreviewKeyDown="QueryTextBox_KeyDown"/>
                <Icon:PackIconMaterial x:Name="SendButton" Kind="ArrowUpCircle" Cursor="Hand"
                                   Grid.Column="2"
                                   Width="43"
                                   Height="43"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   Background="Transparent"
                                   PreviewMouseUp="SendButton_PreviewMouseUp">
                    <Icon:PackIconMaterial.Style>
                        <Style TargetType="Icon:PackIconMaterial">
                            <Setter Property="Foreground" Value="Black"/>
                            <Setter Property="IsEnabled" Value="True"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text.Length, ElementName=QueryTextBox}" Value="0">
                                    <Setter Property="Foreground" Value="LightGray"/>
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Icon:PackIconMaterial.Style>
                </Icon:PackIconMaterial>
            </Grid>
        </Border>
    </Grid>
</Page>
