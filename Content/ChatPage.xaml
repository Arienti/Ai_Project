<Page x:Class="Ai_Project.Content.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Ai_Project.Content"
      xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
      xmlns:ctrls="clr-namespace:Ai_Project.Content.Controls"
      xmlns:dto="clr-namespace:Ai_Project.DTO"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ChatPage"
    xmlns:theme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero2">

    <Grid Background="#eff1f5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="325"/>
        </Grid.ColumnDefinitions>
        <Border Margin="5 2 0 5" Background="#FFF3F3F3" CornerRadius="15">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="6.0" Opacity="0.5" Direction="320" BlurRadius="8" Color="Black" />
            </Border.Effect>
        </Border>
        <Grid Margin="18 0 18 0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="124px"/>
            </Grid.RowDefinitions>
            <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Border x:Name="WelcomeAiBorder" CornerRadius="43" Height="113"  VerticalAlignment="Top" Margin="0 43 0 0" Background="{StaticResource TextChatBGColor}">
                        <StackPanel HorizontalAlignment="Stretch" 
                                VerticalAlignment="Stretch" 
                                Orientation="Vertical"
                                Margin="0 6 0 0">
                            <TextBlock Text="Hello"
                                   FontSize="43"
                                   Foreground="{StaticResource ChatForeground}"
                                   HorizontalAlignment="Center"                                   />
                            <TextBlock Text="I am here to assist you. Please feel free to ask any questions."
                                   FontSize="16"
                                   Foreground="{StaticResource ChatForeground}"
                                   HorizontalAlignment="Center"
                                   Margin="0 10 0 0"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Style="{DynamicResource ScrollViewerStyle}" x:Name="PromptMessagesScroll"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="0 5 0 0">
                        <StackPanel x:Name="PromptMessagesPanel" Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Border  Grid.RowSpan="2" 
                 x:Name="UserPrompt"
                 CornerRadius="28" 
                 Margin="0 15"
                 MinHeight="90px" 
                 MaxHeight="340px"
                 BorderThickness="1" 
                 BorderBrush="DarkGray"
                 Background="White"
            HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="15 6 15 6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="43px"/>
                    </Grid.ColumnDefinitions>
                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <TextBlock Text="Ask anything . . ." 
                               FontSize="16" 
                               Foreground="Gray"
                               IsHitTestVisible="False"
                               HorizontalAlignment="Left" 
                               VerticalAlignment="Center"
                               Margin="4 0 0 0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <!-- Show TextBlock only when the TextBox is empty -->
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=QueryTextBox}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <emoji:RichTextBox x:Name="QueryTextBox"
                                         FontSize="16"
                                         FontFamily="Segoe UI, Segoe UI Emoji, Segoe UI Symbol"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         BorderThickness="0"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Center"
                                         Margin="0 0 0 0"
                                         PreviewKeyDown="QueryTextBox_KeyDown"
                                         Background="Transparent"/>
                    </Grid>
                    <Icon:PackIconMaterial x:Name="SendButton" Kind="ArrowUpCircle" Cursor="Hand"
                                           Grid.Column="1"
                                           Grid.RowSpan="3"
                                           Width="43"
                                           Height="43"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"
                                           Background="Transparent"
                                           PreviewMouseUp="SendButton_PreviewMouseUp">
                        <Icon:PackIconMaterial.Style>
                            <Style TargetType="Icon:PackIconMaterial">
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text.Length, ElementName=QueryTextBox}" Value="0">
                                        <Setter Property="Foreground" Value="LightGray"/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Icon:PackIconMaterial.Style>
                    </Icon:PackIconMaterial>
                    <Grid Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="11"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="11"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="11"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Model:"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource PrimaryBg}"/>
                            
                            <ComboBox Style="{StaticResource ComboBoxStyle1}" Grid.Column="2" 
                                      Margin="0 3 0 0" 
                                      Height="16" 
                                      MinWidth="77" 
                                      MaxDropDownHeight="125" 
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Temperature:"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource PrimaryBg}"/>

                            <Icon:PackIconMaterial Kind="Plus"
                                                   x:Name="PlusTempButton"
                                                   Grid.Column="2"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Height="8"
                                                   Width="8"
                                                   Cursor="Hand"
                                                   Background="Transparent"
                                                   Foreground="{StaticResource PrimaryBg}"
                                                   PreviewMouseLeftButtonDown="PackIconMaterial_PreviewLeftMouseDown"
                                                   PreviewMouseLeftButtonUp="IconsButton_PreviewMouseLeftButtonUp"/>

                            <Border Grid.Column="4" BorderThickness=" 0 0 0 1" BorderBrush="Gray" VerticalAlignment="Center">
                                <TextBox Text="0.5"
                                         x:Name="TempTextBox"
                                         BorderThickness="0"
                                         Width="20"
                                         TextAlignment="Center"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Background="Transparent"/>
                            </Border>

                            <Icon:PackIconMaterial Grid.Column="6" 
                                                   Kind="Minus"
                                                   x:Name="MinusTempButton"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Height="8"
                                                   Width="7"
                                                   Cursor="Hand"
                                                   Background="Transparent"
                                                   Foreground="{StaticResource PrimaryBg}"
                                                   PreviewMouseLeftButtonDown="PackIconMaterial_PreviewLeftMouseDown"
                                                   PreviewMouseLeftButtonUp="IconsButton_PreviewMouseLeftButtonUp"/>
                        </Grid>

                        <Grid Grid.Column="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Max_Token:"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource PrimaryBg}"/>

                            <Icon:PackIconMaterial Kind="Plus"
                                                   x:Name="PlusTokenButton"
                                                   Grid.Column="2"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Height="8"
                                                   Width="8"
                                                   Cursor="Hand"
                                                   Background="Transparent"
                                                   Foreground="{StaticResource PrimaryBg}"
                                                   PreviewMouseLeftButtonDown="PackIconMaterial_PreviewLeftMouseDown"
                                                   PreviewMouseLeftButtonUp="IconsButton_PreviewMouseLeftButtonUp"/>

                            <Border Grid.Column="4" BorderThickness=" 0 0 0 1" BorderBrush="Gray" VerticalAlignment="Center">
                                <TextBox Text="500"
                                         Width="25"
                                         x:Name="MaxTokenTextBox"
                                         BorderThickness="0"
                                         HorizontalAlignment="Center"
                                         TextAlignment="Center"
                                         VerticalAlignment="Center"
                                         Background="Transparent"/>
                            </Border>
                            <Icon:PackIconMaterial Kind="Minus"
                                                   x:Name="MinusTokenButton"
                                                   Grid.Column="6"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Height="8"
                                                   Width="8"
                                                   Cursor="Hand"
                                                   Background="Transparent"
                                                   Foreground="{StaticResource PrimaryBg}"
                                                   PreviewMouseLeftButtonDown="PackIconMaterial_PreviewLeftMouseDown"
                                                   PreviewMouseLeftButtonUp="IconsButton_PreviewMouseLeftButtonUp"/>
                        </Grid>

                        <Menu Grid.Column="6" VerticalAlignment="Center" Background="Transparent">
                            <MenuItem StaysOpenOnClick="False">
                                <MenuItem.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="More" Margin="0,0,3,2"/>
                                            <!-- Small down arrow -->
                                            <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="Gray"
                                                  Width="8"
                                                  Height="4"
                                                  VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </MenuItem.HeaderTemplate>

                                <MenuItem Header="Add File"/>
                                <MenuItem Header="Add Image"/>
                                <MenuItem Header="Optimize Prompt"/>
                            </MenuItem>
                        </Menu>

                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Border Margin="8 2 8 5" Grid.Column="1" Background="#FFf3f3f3" CornerRadius="15">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="6.0" Opacity="0.5" Direction="320" BlurRadius="8" Color="Black" />
            </Border.Effect>
            <Grid Margin="14 5 14 5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="43"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="27"/>
                    <RowDefinition Height="7"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="43"/>
                </Grid.RowDefinitions>
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="8 0 8 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="27"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="27"/>
                    </Grid.ColumnDefinitions>
                    <Icon:PackIconMaterial HorizontalAlignment="Stretch" 
                                           VerticalAlignment="Stretch"
                                           Kind="FileDocument"
                                           Width="18"
                                           Height="18"
                                           Foreground="{StaticResource ThirdBg}"/>
                    <TextBlock Grid.Column="1"
                               Text="History"
                               FontSize="18px"
                               Margin="5 0 0 0"
                               FontWeight="DemiBold"
                               Foreground="{StaticResource ThirdBg}"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Center"/>
                    <Border x:Name="searchButton"
                            Grid.Column="2"
                            Height="21"
                            Width="21"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            CornerRadius="6"
                            BorderThickness="1"
                            Cursor="Hand"
                            Focusable="True"
                            Background="Transparent"
                            BorderBrush="{StaticResource CodeBackgroudControl}"
                            GotFocus="searchButton_GotFocus"
                            LostFocus="searchButton_GotFocus"
                            MouseLeftButtonUp="searchButton_MouseLeftButtonUp">
                        <Icon:PackIconMaterial Grid.Column="2"
                                           HorizontalAlignment="Stretch" 
                                           VerticalAlignment="Stretch"
                                           Kind="MagnifyExpand"
                                           Width="11"
                                           Height="11"
                                           Background="Transparent"
                                           Foreground="{StaticResource CodeBackgroudControl}"/>
                    </Border>
                </Grid>
                
                <Border x:Name="searchBorder"
                        Grid.Row="2" 
                        BorderThickness="2" 
                        BorderBrush="{StaticResource ThirdBg}"
                        CornerRadius="10"
                        Height="0"
                        Visibility="Collapsed">
                    <Grid HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Icon:PackIconMaterial Kind="Magnify"
                                               IsHitTestVisible="False"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource CodeBackgroudControl}"/>
                        <TextBox x:Name="searchTextBox"
                                 Grid.Column="1" 
                                 BorderThickness="0"
                                 VerticalAlignment="Center"
                                 FontSize="14"
                                 Margin="3 0 0 0"
                                 Background="Transparent"
                                 Foreground="{StaticResource PrimaryBgHover}"
                                 LostFocus="TextBox_LostFocus"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="4" 
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="(12)Items"
                               Margin="1 0 0 0"
                               Foreground="#666666"
                               FontSize="13"/>
                    
                    <Border x:Name="AllTopicButton"
                            Grid.Column="2" 
                            CornerRadius="50"
                            Width="27"
                            Height="27"
                            Background="{StaticResource ThirdBg}"
                            Cursor="Hand"
                            Focusable="True"
                            MouseEnter="Border_MouseEnter"
                            MouseLeave="Border_MouseLeave"
                            PreviewMouseUp="All_PreviewMouseUp">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="All"
                                   Foreground="White"/>
                    </Border>

                    <Border x:Name="FavoritesTopicButton"
                            Grid.Column="3" 
                            CornerRadius="6"
                            Margin="8 0 0 0"
                            Background="{StaticResource SecondaryHoverBg}"
                            Cursor="Hand"
                            Focusable="True"
                            MouseEnter="Border_MouseEnter"
                            MouseLeave="Border_MouseLeave"
                            PreviewMouseLeftButtonUp="All_PreviewMouseUp">
                        <StackPanel Orientation="Horizontal" Margin="3 0 8 0">
                            <Icon:PackIconMaterial Kind="StarOutline"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="White"/>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="Favorites"
                                       Margin="3 0 0 0"
                                       Foreground="White"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border x:Name="deleteHistoryBtn"
                        Grid.Row="7" 
                        CornerRadius="10"
                        Height="43"
                        Cursor="Hand"
                        PreviewMouseLeftButtonUp="deleteHistoryBtn_PreviewMouseLeftButtonUp">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource SecondaryHoverBg}"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="{StaticResource SecondaryColorBg}"
                                                    Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="{StaticResource SecondaryHoverColorBg}"
                                                    Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                        <Icon:PackIconMaterial Kind="TrashCan"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="White"/>
                        <TextBlock Text="Clear History"
                                   Foreground="White"
                                   FontWeight="DemiBold"
                                   FontSize="15"
                                   Margin="5 0 0 0"/>
                    </StackPanel>
                </Border>
                <ScrollViewer Grid.Row="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{StaticResource ScrollViewerStyle}" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="HistoryList" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Orientation="Vertical"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
