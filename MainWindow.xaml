<Window x:Class="Ai_Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ai_Project"
        xmlns:controls="clr-namespace:Ai_Project.Content.Controls"

        mc:Ignorable="d"
        Title="AI" MinHeight="480" MinWidth="850">
    <Grid x:Name="MainGrid">
        <!--<Grid.Background>
            <ImageBrush ImageSource="D:\Ai_Project\Assets\chatBackGround(2).jpg" Stretch="UniformToFill"/>
        </Grid.Background>-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding ElementName=NavBarGrid, Path=ActualWidth}"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="NavBarGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="200">
            <Grid Background="{StaticResource PrimaryBg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="297px"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Border Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <DockPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Border x:Name="CollapseNavBarBorder" Cursor="Hand"
                                    Background="{StaticResource PrimaryBg}"
                                    VerticalAlignment="Stretch"
                                    HorizontalAlignment="Right"
                                    Margin="0 6 4 6"
                                    Width="47px"
                                    Height="47px"
                                    CornerRadius="50"
                                    ToolTip="Collapse"
                                    PreviewMouseUp="Border_PreviewMouseUp">
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                Duration="0:0:0:0.3" To="#FF3b3f5c"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                Duration="0:0:0:0.3" To="#FF505275"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <Icon:PackIconMaterial Kind="Collage"
                                                       Foreground="{StaticResource PrimaryFg}"
                                                       Width="18"
                                                       Height="18"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                            </Border>
                            <Grid x:Name="NewChatGrid" Grid.Row="1" 
                                  Background="{StaticResource PrimaryBg}" 
                                  HorizontalAlignment="Stretch" 
                                  Margin="0 6 0 6"
                                  Cursor="Hand">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="47px"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Icon:PackIconMaterial Kind="PencilBox" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center" 
                                                       Height="18px" 
                                                       Width="18px" 
                                                       Foreground="{StaticResource FifthBg}"/>
                                <TextBlock x:Name="NewChatTextBlock" Grid.Column="1" Text="New chat" VerticalAlignment="Center" FontSize="21px" Foreground="{StaticResource PrimaryFg}"/>
                            </Grid>

                            <Grid x:Name="ModelsGrid" Grid.Row="2" 
                                  Background="{StaticResource PrimaryBg}" 
                                  HorizontalAlignment="Stretch" 
                                  Margin="0 6 0 6"
                                  Cursor="Hand">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="47px"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Icon:PackIconMaterial Kind="Database"  HorizontalAlignment="Center" VerticalAlignment="Center" Width="18px" Height="18px" Foreground="{StaticResource SecondaryBg}"/>
                                <TextBlock x:Name="ModelsTextBlock" Grid.Column="1" Text="Models" VerticalAlignment="Center" FontSize="21" Foreground="{StaticResource PrimaryFg}"/>
                            </Grid>

                            <Grid x:Name="SettingsGrid" Grid.Row="3" 
                                  Background="{StaticResource PrimaryBg}" 
                                  HorizontalAlignment="Stretch" 
                                  Margin="0 6 0 6"
                                  Cursor="Hand">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="47px"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Icon:PackIconMaterial Kind="Cog"  HorizontalAlignment="Center" VerticalAlignment="Center" Width="18px" Height="18px" Foreground="{StaticResource ThirdBg}"/>
                                <TextBlock x:Name="SettingsTextBlock" Grid.Column="1" Text="Settings" VerticalAlignment="Center" FontSize="21px" Foreground="{StaticResource PrimaryFg}"/>
                            </Grid>

                        </Grid>
                    </DockPanel>
                </Border>
                <!--<Grid x:Name="HistoryGrid" Grid.Row="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="27px"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="History" 
                       Foreground="{StaticResource PrimaryFg}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14px"/>
                    <Border Grid.Row="1" Margin="5 5 0 0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <StackPanel x:Name="HistoryList" HorizontalAlignment="Stretch" Orientation="Vertical" VerticalAlignment="Stretch" Background="{StaticResource PrimaryBg}">

                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>-->
            </Grid>
        </Grid>
        <Frame x:Name="MainFrame" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
